{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*",
      ],
      "@assets/*": [
        "./assets/*",
      ],
      "@components/*": [
        "./src/components/*",
      ],
      "@hooks/*": [
        "./src/hooks/*",
      ],
      "@store/*": [
        "./src/store/*",
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "server", "shared", "drizzle.config.ts"]
}