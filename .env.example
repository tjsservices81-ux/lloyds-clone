# Copy to `.env` for local development. Only DATABASE_URL is strictly required.

# PostgreSQL connection string (required). Any Postgres works — local, Render,
# or Neon; the server auto-detects the right driver.
DATABASE_URL=postgres://user:password@localhost:5432/lloyds

# Signs access tokens. Any long random string; required in production.
JWT_SECRET=change-me-to-a-long-random-string

# Code that unlocks the app via the access gate (/api/check-access).
APP_ACCESS_CODE=LLOYDS777777

# PIN for the staff dashboard at /admin-oversight.
ADMIN_PIN=246810

# Optional: enables the Claude-powered support chat. Without it, chat falls back
# to scripted replies.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Client -> API base URL. Leave empty for a same-origin deploy (the server that
# serves the web build also serves /api). Set to a full URL only if the API is
# hosted separately, e.g. http://localhost:5050 during split local dev.
EXPO_PUBLIC_API_URL=

# Port the server listens on (Render sets this automatically).
PORT=5050
